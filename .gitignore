# Build output
/target

# Editors and tooling
.vs/
.vscode/
.idea/

# Windows leavings
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# The app's own files, which it writes beside the executable. Running a build
# from the repository root would otherwise leave them here to be committed --
# and `config.ini` holds password verifiers.
*.ini
LockScreenData/

# ...but the .NET compatibility fixture must be committed: the test that reads
# it is the regression gate on config compatibility, and it fails on a fresh
# clone without it. Its Password value is a DPAPI blob of the publicly
# documented "1234" default, bound to the machine that generated it, so it is
# not a credential anywhere else.
!crates/lockscreen-core/tests/fixtures/*.ini
