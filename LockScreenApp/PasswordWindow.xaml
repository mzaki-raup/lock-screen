<Window x:Class="LockScreenApp.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Password" Width="400" Height="340" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Loaded="PasswordWindow_Loaded"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Unlock options" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Windows Hello Section -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Authenticating with Windows Hello..." Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="RetryWindowsHelloButton" Content="Retry Windows Hello" Width="150" Height="28" Click="RetryWindowsHelloButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Password and Voice Recognition Section -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="Please enter your password:" Margin="0,0,0,10"/>
                    <PasswordBox x:Name="PasswordBox" Width="250" Height="20" Margin="0,0,0,10"/>

                    <!-- Voice Recognition Status -->
                    <TextBlock x:Name="VoiceStatusText"
                               Text=""
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"
                               Foreground="DarkBlue"
                               FontStyle="Italic"
                               Visibility="Collapsed"/>

                    <!-- Voice Unlock Button -->
                    <Button x:Name="VoiceUnlockButton"
                            Content="🎤 Voice Unlock"
                            Width="150"
                            Height="28"
                            Margin="0,0,0,10"
                            Click="VoiceUnlock_Click"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button x:Name="UnlockButton" Content="Unlock" Padding="10,6" Margin="0,0,8,0" Width="120" Height="28" Click="Unlock_Click"/>
                        <Button x:Name="CancelButton" Content="Cancel" Padding="10,6" Width="120" Height="28" Click="Cancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
