<Window x:Class="SettingsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SettingsApp"
        Title="Settings" Height="420" Width="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        BorderBrush="Black"
        BorderThickness="1">

    <Window.Resources>
        <!-- Converter -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF2B2B2B"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
</Style>
        
            <!-- Text input style -->
            <Style x:Key="TextInputStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#FF888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
        <Setter Property="Padding" Value="8,4"/>
<Setter Property="Template">
        <Setter.Value>
        <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                                    <TextBlock Text="{TemplateBinding Tag}"
                                    Foreground="#FF9A9A9A"
                                    Margin="6,2,0,0"
                            IsHitTestVisible="False"
                            Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                       </Grid>
                                       </Border>
                                       </ControlTemplate>
                                       </Setter.Value>
                        </Setter>
                    </Style>
                
            <!-- Password input style -->
        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
<Setter Property="BorderBrush" Value="#FF888888"/>
        <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
                <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="PasswordBox">
                                <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                </Border>
            </ControlTemplate>
        </Setter.Value>
</Setter>
        </Style>
            
            <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Foreground" Value="#FF2B2B2B"/>
</Style>
    </Window.Resources>
        
            <Grid Margin="16">
            <StackPanel>
<TextBlock Text="Lock screen title" Style="{StaticResource InputLabelStyle}" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox" Tag="Title" Style="{StaticResource TextInputStyle}"/>
            
<TextBlock Text="Transparency (0.0 - 1.0)" Style="{StaticResource InputLabelStyle}"/>
            <TextBox x:Name="TransparencyBox"
                     Tag="Transparency"
                     Style="{StaticResource TextInputStyle}"
                     PreviewTextInput="TransparencyBox_PreviewTextInput"
                     DataObject.Pasting="TransparencyBox_Pasting"/>
            
<TextBlock Text="Background options" Style="{StaticResource InputLabelStyle}"/>
            <CheckBox x:Name="BlurCheckBox" Content="Enable Blur"/>

<TextBlock Text="Voice recognition" Style="{StaticResource InputLabelStyle}"/>
            <CheckBox x:Name="VoiceEnabledCheckBox" Content="Enable voice unlock" Checked="VoiceEnabled_Changed" Unchecked="VoiceEnabled_Changed"/>
            <Button x:Name="TestMicrophoneButton"
                    Content="Test Microphone"
                    Padding="8,4"
                    Margin="0,5,0,0"
                    Click="TestMicrophone_Click"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"/>
            <TextBlock x:Name="VoiceTestStatusText"
                       Text=""
                       Margin="0,5,0,0"
                       Foreground="DarkBlue"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

<TextBlock Text="New password (optional)" Style="{StaticResource InputLabelStyle}"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PasswordInputStyle}"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Save" Click="Save_Click" Padding="10,6" Margin="0,0,8,0"/>
                <Button Content="Cancel" Click="Cancel_Click" Padding="10,6" IsCancel="True" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>